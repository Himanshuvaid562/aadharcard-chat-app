{
  "name": "aadhaarchat",
  "version": "2.0.0",
  "description": "AadhaarChat — Secure messaging with Aadhaar verification (React + Express + MongoDB + Socket.IO)",
  "type": "commonjs",
  "scripts": {
    "dev:server": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix client install || true"
  },
  "keywords": ["aadhaar","chat","socket.io","react","mongodb"],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
